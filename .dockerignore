# Version control
.git/
.gitignore
.gitmodules

# Python artifacts
__pycache__/
*.py[oc]
*.egg-info/
.venv/
.pytest_cache/
.ruff_cache/

# Node / Frontend artifacts
frontend/node_modules/
frontend/dist/
frontend/.svelte-kit/
frontend/.vite/

# IDE / tooling
.vscode/
.claude/
.antigravity/
.gemini/
.Jules/
.playwright-mcp/
.github/

# Secrets — never bake into image
.env
*.env
.sesskey

# Runtime data (mounted via volumes at runtime, not baked into image)
data/cache/
data/uploads/
data/migration/
data/*.ifc
data/*.bcf
data/*.sqlite
data/*.sqlite-shm
data/*.sqlite-wal
data/agent-sessions/
data/logs/
data/bimguard_issue_history.json

# Documentation, test fixtures, and scripts not needed in production image
docs/
scripts/
supabase/
docker/
IFC-Sample-Test-Files/
tests/
app/modules/tests/

# Local databases and agents
.kuzu_db/
.oxigraph_db/
.agents/
.copilot/

# Misc
*.md
!README.md
open_issues_full.json
