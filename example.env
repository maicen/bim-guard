db_password=...

# Supabase project and API keys
SUPABASE_URL=...
SUPABASE_KEY=...
SUPABASE_PUBLISHABLE_KEY=...
SUPABASE_SERVICE_ROLE_KEY=...
SUPABASE_SECRET_KEY=...
SUPABASE_JWKS_URL=...
SUPABASE_STORAGE_BUCKET=bim-guard-artifacts
# Optional prefix applied to every object key.
SUPABASE_STORAGE_PREFIX=

# Public client envs
NEXT_PUBLIC_SUPABASE_URL=...
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=...

# Supabase CLI PAT (must be an sbp_ token)
SUPABASE_ACCESS_TOKEN=...

# S3-compatible storage access
S3_ACCESS_KEY_ID=...
S3_SECRET_ACCESS_KEY=...
S3_ENDPOINT_URL=...
S3_REGION=...

# Runtime model selection. Provider credentials are discovered by LiteLLM.
BIM_GUARD_LLM_MODEL=gemini/gemini-2.0-flash
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_KEY=...
GEMINI_API_KEY=...

# Optional corrosion rule packs. Only the exact string 1 enables a pack.
FEATURE_PATH_B_MM=0
FEATURE_PATH_B_XM=0

# Logging — verbosity degree 0..4 (0=ERROR, 1=WARNING, 2=INFO, 3=DEBUG, 4=TRACE).
BIM_GUARD_VERBOSITY=1
# Explicit level name overrides the verbosity degree above.
# BIM_GUARD_LOG_LEVEL=DEBUG
# Optional log file; logs always go to stderr as well.
# BIM_GUARD_LOG_FILE=data/logs/bim-guard.log