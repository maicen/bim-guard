db_password=...

# Supabase project and API keys
SUPABASE_URL=...
SUPABASE_KEY=...
SUPABASE_PUBLISHABLE_KEY=...
SUPABASE_SERVICE_ROLE_KEY=...
SUPABASE_SECRET_KEY=...
SUPABASE_JWKS_URL=...
SUPABASE_STORAGE_BUCKET=bim-guard-artifacts
# Optional prefix applied to every object key.
SUPABASE_STORAGE_PREFIX=

# Public client envs
NEXT_PUBLIC_SUPABASE_URL=...
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=...

# Supabase CLI PAT (must be an sbp_ token)
SUPABASE_ACCESS_TOKEN=...

# ── Local Development Database & Storage (Supabase CLI) ──────────────────────
# By default the app talks to the team's shared hosted Supabase project
# (the SUPABASE_* values above) for both Postgres and file storage — this is
# what production always uses. For local development against a disposable
# database and local file storage instead:
#   1. supabase start
#      Boots a full local stack in Docker (Postgres, Auth, Storage, Studio)
#      and replays every file in supabase/migrations/ against it, so you get
#      the real schema (including the Arch-only CHECK constraints) locally.
#   2. Copy the "API URL", "anon key" and "service_role key" it prints into
#      the SUPABASE_* variables above, e.g.:
#        SUPABASE_URL=http://127.0.0.1:54321
#        SUPABASE_KEY=<local anon key>
#        SUPABASE_PUBLISHABLE_KEY=<local anon key>
#        SUPABASE_SERVICE_ROLE_KEY=<local service_role key>
#      These local keys are fixed, non-secret, publicly-documented defaults
#      of the Supabase CLI (not a credential to the hosted project) — see
#      example.env.local for these values already filled in, ready to paste.
#   3. frontend/.env needs the matching VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY
#      pair — see frontend/.env.example.
#   4. If you also run `docker compose up` locally (for opencde/neo4j/docling),
#      set OPENCDE_SUPABASE_URL=http://host.docker.internal:54321 as well —
#      see docker-compose.override.yml for why.
# `supabase stop` tears the local stack down; `supabase db reset` wipes and
# replays migrations again for a clean slate.

# Runtime model selection. OpenRouter is the default provider.
BIM_GUARD_LLM_MODEL=openrouter/auto
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_SITE_URL=http://127.0.0.1:8000
OPENROUTER_APP_NAME=BIM Guard
# Python agent TUI configuration.
BIM_GUARD_AGENT_MODEL=openrouter/auto
BIM_GUARD_AGENT_MAX_STEPS=20
BIM_GUARD_AGENT_MAX_COST=1.0
BIM_GUARD_AGENT_SESSION_DIR=data/agent-sessions
BIM_GUARD_AGENT_WEB_SEARCH=1
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_KEY=...
GEMINI_API_KEY=...
# Optional Ollama server used by local LLM extraction.
OLLAMA_API_BASE=http://localhost:11434

# Optional corrosion rule packs. Only the exact string 1 enables a pack.
FEATURE_PATH_B_MM=0
FEATURE_PATH_B_XM=0

# Required to authorize the separate IFC enhancement command.
BIM_GUARD_ENHANCEMENT_TOKEN=...

# Logging — verbosity degree 0..4 (0=ERROR, 1=WARNING, 2=INFO, 3=DEBUG, 4=TRACE).
BIM_GUARD_VERBOSITY=1
# Explicit level name overrides the verbosity degree above.
# BIM_GUARD_LOG_LEVEL=DEBUG
# Optional log file; logs always go to stderr as well.
# BIM_GUARD_LOG_FILE=data/logs/bim-guard.log

# Analysis result cache (app/services/analysis_cache.py). The store is
# per-process and in-memory: a restart empties it, and a miss only ever costs
# time. Entries are keyed on the model digest, so a long TTL cannot serve a
# stale answer for a model that changed.
# How many results to hold before evicting the least recently used.
BIMGUARD_CACHE_ENTRIES=64
# How long an entry stays usable, in seconds. 86400 = one day, so a results
# page revisited hours later is served rather than recomputed.
BIMGUARD_CACHE_TTL_SECONDS=86400

# Neo4j graph database. `docker compose up` starts a neo4j service by default
# now and the app's NEO4J_URI there defaults to bolt://neo4j:7687 -- you don't
# need to set anything here for that path.
#
# Running the backend directly with `uv run uvicorn` (no Docker) instead:
# either start just the Neo4j container (`docker compose up -d neo4j`) and
# uncomment the block below pointing at bolt://localhost:7687, or leave
# NEO4J_URI unset to fall back to the embedded Kùzu database (no server
# needed, but no Neo4j Browser visualization either).
# For a hosted instance (e.g. Neo4j Aura) from either path:
#   NEO4J_URI=neo4j+s://<dbid>.databases.neo4j.io
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USERNAME=neo4j
# NEO4J_PASSWORD=bimguardpassword
# NEO4J_DATABASE=neo4j

# Only needed if you run `docker compose up` locally (for opencde/neo4j/docling)
# AND SUPABASE_URL above points at a local `supabase start` stack. opencde
# runs inside the Compose network, where 127.0.0.1 means the opencde
# container itself, not your host -- so its Supabase JWKS lookup needs
# Docker's host-loopback alias instead. See docker-compose.override.yml.
# OPENCDE_SUPABASE_URL=http://host.docker.internal:54321

# ── Cloudflare Tunnel & Domain Routing ────────────────────────────────────────
# Comma-separated list of allowed CORS origins when serving from a custom domain.
# Localhost origins (8000, 5173, 3000) are automatically preserved.
# BIM_GUARD_ALLOWED_ORIGINS=https://bim.yourdomain.com

# Cloudflare Zero Trust Remote Tunnel token.
# Required if running `cloudflared` via Docker Compose (`docker compose --profile tunnel up -d`).
# TUNNEL_TOKEN=eyJh...

# Optional: activate compose profiles automatically without passing `--profile`.
# COMPOSE_PROFILES=tunnel

# ── LAN / OrbStack Cross-Device Development Access ────────────────────────────
# To reach the dev stack from another PC on the same LAN (e.g. for testing on
# a second machine or browsing from a phone), two things must be set so the
# browsers on those devices are not blocked:
#
# 1. Backend CORS — add the LAN origin(s) to BIM_GUARD_ALLOWED_ORIGINS.
#    Find your Mac's LAN IP with: ipconfig getifaddr en0
#    Example:
# BIM_GUARD_ALLOWED_ORIGINS=http://192.168.14.77:5173,http://192.168.14.77:8000
#
# 2. Vite dev-server allowed hosts — add your LAN IP(s) to
#    BIMGUARD_ALLOWED_HOSTS (comma-separated). Vite's host check rejects any
#    Host header it doesn't recognise, so this must match what the browser
#    sends in its Host header (i.e. the IP or hostname the other PC uses).
#    Example:
# BIMGUARD_ALLOWED_HOSTS=192.168.14.77
#
# Then start the full stack normally: ./run_server.sh
# The frontend will be reachable at http://<your-lan-ip>:5173 from any device
# on the same network.  Auth: use the dev-password login (Google OAuth doesn't
# support bare LAN IPs as redirect URIs).



