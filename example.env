db_password=...

# ── Supabase Configuration (Self-Hosted Production Stack) ────────────────────
# The production database, auth, and storage run as self-hosted Docker containers
# (docker/supabase/) integrated into docker-compose.yml.
# - On the host (uv run uvicorn / pytest): use http://localhost:54321
# - Inside Docker containers (bim-guard-app / opencde): use http://kong:8000
SUPABASE_URL=http://localhost:54321
SUPABASE_INTERNAL_URL=http://kong:8000
SUPABASE_KEY=...
SUPABASE_PUBLISHABLE_KEY=...
SUPABASE_SERVICE_ROLE_KEY=...
SUPABASE_SECRET_KEY=...
SUPABASE_JWKS_URL=http://localhost:54321/auth/v1/.well-known/jwks.json
SUPABASE_INTERNAL_JWKS_URL=http://kong:8000/auth/v1/.well-known/jwks.json
JWT_SECRET=...
SUPABASE_STORAGE_BUCKET=bim-guard-artifacts
SUPABASE_STORAGE_PREFIX=

# Public client envs (Browser SPA builds / Cloudflare Tunnel)
PUBLIC_SUPABASE_URL=https://supabase.bim-guard.xyz
PUBLIC_SUPABASE_PUBLISHABLE_KEY=...
VITE_SUPABASE_URL=https://supabase.bim-guard.xyz
VITE_SUPABASE_ANON_KEY=...

# ── Hosted Supabase (Dev-Only Fallback, internal team only) ─────────────────
# The remote hosted Supabase project (pmisdhiigakpjfuyxgfb.supabase.co) is retained
# exclusively for dev/staging experiments by the core team. Internal team members
# with access to the shared credentials vault can copy them into a local, gitignored
# `.env.hosted_dev` file to point at the hosted project instead of the local Docker
# stack. External contributors: skip this — it isn't required (or available) for
# local development; use the self-hosted Docker stack or `supabase start` instead.


# Runtime model selection. OpenRouter is the default provider.
BIM_GUARD_LLM_MODEL=openrouter/auto
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_SITE_URL=http://127.0.0.1:8000
OPENROUTER_APP_NAME=BIM Guard
# Python agent TUI configuration.
BIM_GUARD_AGENT_MODEL=openrouter/auto
BIM_GUARD_AGENT_MAX_STEPS=20
BIM_GUARD_AGENT_MAX_COST=1.0
BIM_GUARD_AGENT_SESSION_DIR=data/agent-sessions
BIM_GUARD_AGENT_WEB_SEARCH=1
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_KEY=...
GEMINI_API_KEY=...
# Optional: base URL of a self-hosted Ollama server (http://localhost:11434
# is Ollama's default port). Only needed if you select an "ollama/..." model
# — if Ollama isn't installed, leave this unset and nothing else is affected.
#
# - Running the backend directly on this machine (`uv run uvicorn`, no
#   Docker): this value is used as-is, so `http://localhost:11434` reaches
#   Ollama running on the same machine.
# - Running via `docker compose up`: leave this unset. docker-compose.yml
#   already defaults OLLAMA_API_BASE to `http://host.docker.internal:11434`
#   inside the container, which reaches Ollama on the Docker host (works for
#   both production and local Docker testing) — setting it here to
#   `localhost` would instead point the container at itself and fail.
OLLAMA_API_BASE=http://localhost:11434

# Optional corrosion rule packs. Only the exact string 1 enables a pack.
FEATURE_PATH_B_MM=0
FEATURE_PATH_B_XM=0

# Required to authorize the separate IFC enhancement command.
BIM_GUARD_ENHANCEMENT_TOKEN=...

# Logging — verbosity degree 0..4 (0=ERROR, 1=WARNING, 2=INFO, 3=DEBUG, 4=TRACE).
BIM_GUARD_VERBOSITY=1
# Explicit level name overrides the verbosity degree above.
# BIM_GUARD_LOG_LEVEL=DEBUG
# Optional log file; logs always go to stderr as well.
# BIM_GUARD_LOG_FILE=data/logs/bim-guard.log

# Analysis result cache (app/services/analysis_cache.py). The store is
# per-process and in-memory: a restart empties it, and a miss only ever costs
# time. Entries are keyed on the model digest, so a long TTL cannot serve a
# stale answer for a model that changed.
# How many results to hold before evicting the least recently used.
BIMGUARD_CACHE_ENTRIES=64
# How long an entry stays usable, in seconds. 86400 = one day, so a results
# page revisited hours later is served rather than recomputed.
BIMGUARD_CACHE_TTL_SECONDS=86400

# ── Neo4j / Docling (optional outside Docker) ────────────────────────────────
# Neo4j and Docling are only required when using `docker compose up` — both
# start automatically as part of that stack. Running the backend directly with
# `uv run uvicorn` needs neither: graph queries fall back to the embedded Kùzu
# database and document parsing falls back to local handling, no extra setup.
#
# Neo4j graph database. `docker compose up` starts a neo4j service by default
# now and the app's NEO4J_URI there defaults to bolt://neo4j:7687 -- you don't
# need to set anything here for that path.
#
# Running the backend directly with `uv run uvicorn` (no Docker) instead:
# either start just the Neo4j container (`docker compose up -d neo4j`) and
# uncomment the block below pointing at bolt://localhost:7687, or leave
# NEO4J_URI unset to fall back to the embedded Kùzu database (no server
# needed, but no Neo4j Browser visualization either).
# For a hosted instance (e.g. Neo4j Aura) from either path:
#   NEO4J_URI=neo4j+s://<dbid>.databases.neo4j.io
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USERNAME=neo4j
# NEO4J_PASSWORD=bimguardpassword
# NEO4J_DATABASE=neo4j

# Only needed if you run `docker compose up` locally (for opencde/neo4j/docling)
# AND SUPABASE_URL above points at a local `supabase start` stack. opencde
# runs inside the Compose network, where 127.0.0.1 means the opencde
# container itself, not your host -- so its Supabase JWKS lookup needs
# Docker's host-loopback alias instead. See docker-compose.override.yml.
# OPENCDE_SUPABASE_URL=http://host.docker.internal:54321

# ── Cloudflare Tunnel & Domain Routing ────────────────────────────────────────
# Comma-separated list of allowed CORS origins when serving from a custom domain.
# Localhost origins (8000, 5173, 3000) are automatically preserved.
# BIM_GUARD_ALLOWED_ORIGINS=https://bim.yourdomain.com

# Cloudflare Zero Trust Remote Tunnel token.
# Required if running `cloudflared` via Docker Compose (`docker compose --profile tunnel up -d`).
# TUNNEL_TOKEN=eyJh...

# Optional: activate compose profiles automatically without passing `--profile`.
# COMPOSE_PROFILES=tunnel

# ── Cross-Device Development Access ──────────────────────────────────────────
# To reach the dev stack from another machine, set the following env vars.
# Two scenarios:
#
# ── A. Same LAN (all devices on the same network) ─────────────────────────────
# Find your Mac's LAN IP:  ipconfig getifaddr en0
#
# 1. Allow the backend to respond to requests from the LAN origin:
# BIM_GUARD_ALLOWED_ORIGINS=http://192.168.1.100:5173,http://192.168.1.100:8000
#
# 2. Allow Vite to accept the non-localhost Host header:
# BIMGUARD_ALLOWED_HOSTS=192.168.1.100
#
# Then ./run_server.sh  →  open http://<your-lan-ip>:5173 on the other device.
# Auth: use the "Sign in as dev test user" button (Google OAuth won't work for
# bare IPs).
#
# ── B. Internet / remote PCs (different network) ──────────────────────────────
# Use Cloudflare Tunnel to expose the Vite dev server publicly over HTTPS.
# cloudflared is already on your Mac (brew install cloudflared).
#
# Option B1 — Named tunnel (permanent dev URL, e.g. dev.bim-guard.xyz):
#   1. In Zero Trust dashboard → Networks → Tunnels → bim-guard → Edit:
#      Add public hostname:  Subdomain=dev  Domain=bim-guard.xyz
#                            Type=HTTP  URL=localhost:5173
#   2. Run: ./scripts/dev_tunnel.sh          (reads TUNNEL_TOKEN from .env)
#   3. Set the two vars below and restart the backend.
#
# Option B2 — Quick anonymous tunnel (random *.trycloudflare.com URL):
#   1. Run: ./scripts/dev_tunnel.sh --quick
#      The URL appears in stdout — share it with your colleague.
#   2. Set BIM_GUARD_ALLOWED_ORIGINS=* for the backend (temporary only):
#      BIM_GUARD_ALLOWED_ORIGINS=* uv run uvicorn main:app --reload
#
# For both named and quick tunnel, Vite's host check must be disabled because
# the hostname coming from Cloudflare is an external domain:
# BIMGUARD_ALLOWED_HOSTS=*
#
# Named tunnel — add the public URL as an allowed CORS origin:
# BIM_GUARD_ALLOWED_ORIGINS=https://dev.bim-guard.xyz
# BIMGUARD_ALLOWED_HOSTS=*




