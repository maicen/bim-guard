# Copy this file to .env and fill in real values
# Windows PowerShell:
#   Copy-Item example.env .env

# LLM provider API keys — litellm reads whichever key matches the chosen provider.
# Leave all blank to rely on keys already set in the system environment.

# OpenAI (models: gpt-4o, gpt-4o-mini, gpt-4-turbo, gpt-3.5-turbo, ...)
OPENAI_API_KEY=

# Google Gemini (models: gemini/gemini-2.0-flash, gemini/gemini-1.5-pro, ...)
GEMINI_API_KEY=

# Anthropic (models: anthropic/claude-3-5-sonnet-20241022, claude-3-5-haiku, ...)
ANTHROPIC_API_KEY=

# Mistral (models: mistral/mistral-large-latest, mistral-small-latest, ...)
MISTRAL_API_KEY=

# Optional: default model used when no model is selected in the UI.
# Must be a valid litellm model string (see https://docs.litellm.ai/docs/providers).
BIM_GUARD_RULE_MODEL=gpt-4o-mini

# Supabase project URL
SUPABASE_URL=
# Prefer service-role key for server-side migrations and backend operations.
SUPABASE_SERVICE_ROLE_KEY=
# Backward-compatible fallback key variable used in parts of the app.
SUPABASE_KEY=

# Storage backend selector: local | supabase
BIM_GUARD_STORAGE_BACKEND=local
# DB backend selector: sqlite | supabase
BIM_GUARD_DB_BACKEND=sqlite
# Target bucket for uploaded artifacts when storage backend is supabase.
SUPABASE_STORAGE_BUCKET=bim-guard-artifacts
# Optional object prefix (e.g., prod, staging, migration).
SUPABASE_STORAGE_PREFIX=

# Source DB for one-time migration scripts.
SOURCE_SQLITE_PATH=data/bimguard.sqlite
