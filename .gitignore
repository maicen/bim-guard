# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Environment variables (contains secrets — never commit)
.env

# Virtual environments
.venv
tmp_sig_check.sqlite
.playwright-mcp/
.sesskey
# data/cache/ (narrowed below — only the Supabase Storage cache is disposable)
.DS_Store
docs/MonsterUI/

apply_benchmark_patch*.ps1

# User-uploaded files and generated artifacts (not seed data)
data/uploads/
data/bimguard.sqlite
data/bimguard.sqlite-wal
data/bimguard_issue_history.json
data/compliance_project_*.bcf
data/BIMGuard_IFC4_Export.json

# Runtime artifacts are durable in Supabase Storage; local copies are disposable.
data/cache/supabase-storage/
data/agent-sessions/

# Validation sweep inputs/outputs: ~1.8 GB, fully regenerable.
# Models re-download from the URLs in the validation dataset doc; BCF
# archives re-export from the cached per-model results. The evidentiary
# summary (validation_sweep_summary.json) and Appendix A are tracked.
data/validation_models/
data/validation_bcf/
data/validation_results/

# Phase 5 test artifacts: regenerated by test_real_ifc_pipeline.py on every
# run and differing only in embedded GUIDs and timestamps, so they churn
# without conveying change. The run's PASS/FAIL result is the evidence, not
# the binaries. validate_blue_halo_output_REAL_CONFIG.txt stays tracked as
# the human-readable record.
test_output.bcf
test_hospital_mep_halos.json

# Test and analysis run logs: regenerated on every run, no durable value.
pytest_run.log
route_tests.log
analysis_*.log
server.log
server_run.log
validation_sweep_retry.log

# git format-patch exports (transfer artifacts, not source)
*.patch

# SQLite transient files (should never be tracked)
*.sqlite-shm
*.sqlite-wal
*.sqlite-journal

# Local MCP server config (machine-specific, may hold credentials)
.mcp.json

# E2E test model dataset (cloned from maicen/bimguard-test-models, ~1.3 GB).
# No trailing slash: the dataset is often a symlink to a clone kept outside
# the working tree, and "test-models/" matches only a real directory.
test-models
