# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Environment variables (contains secrets — never commit)
.env

# Virtual environments
.venv
tmp_sig_check.sqlite
.playwright-mcp/
.sesskey
# data/cache/ (narrowed below — only the Supabase Storage cache is disposable)
.DS_Store
docs/MonsterUI/

apply_benchmark_patch*.ps1

# User-uploaded files and generated artifacts (not seed data)
data/uploads/
data/bimguard.sqlite
data/bimguard.sqlite-wal
data/bimguard_issue_history.json
data/compliance_project_*.bcf
data/BIMGuard_IFC4_Export.json

# Runtime artifacts are durable in Supabase Storage; local copies are disposable.
data/cache/supabase-storage/
data/agent-sessions/

# Source PDFs cached by fetch_standards.py --local-pdf. Tens of megabytes each
# (FEMA E-74 alone is 67 MiB) and re-downloadable from the URL recorded in the
# provenance header of the extracted Markdown.
data/cache/standards-pdf/

# Validation sweep inputs/outputs: ~1.8 GB, fully regenerable.
# Models re-download from the URLs in the validation dataset doc; BCF
# archives re-export from the cached per-model results. The evidentiary
# summary (validation_sweep_summary.json) and Appendix A are tracked.
data/validation_models/
data/validation_bcf/
data/validation_results/

# Phase 5 test artifacts: regenerated by test_real_ifc_pipeline.py on every
# run and differing only in embedded GUIDs and timestamps, so they churn
# without conveying change. The run's PASS/FAIL result is the evidence, not
# the binaries. validate_blue_halo_output_REAL_CONFIG.txt stays tracked as
# the human-readable record.
test_output.bcf
test_hospital_mep_halos.json

# Test and analysis run logs: regenerated on every run, no durable value.
pytest_run.log
route_tests.log
analysis_*.log
server.log
server_run.log
validation_sweep_retry.log

# git format-patch exports (transfer artifacts, not source)
*.patch

# SQLite transient files (should never be tracked)
*.sqlite-shm
*.sqlite-wal
*.sqlite-journal

# Local MCP server config (machine-specific, may hold credentials)
.mcp.json

# E2E test model dataset (cloned from maicen/bimguard-test-models, ~1.3 GB).
# No trailing slash: the dataset is often a symlink to a clone kept outside
# the working tree, and "test-models/" matches only a real directory.
test-models

# --- Master's submission hygiene -------------------------------------------

# Log files anywhere. The curated validation logs under docs/validation/logs/
# are evidentiary (thesis Appendix B) and stay tracked via the negation below.
*.log
!docs/validation/logs/*.log

# Firecrawl scrape output: transient RAG retrieval artifacts, regenerable with
# `python scripts/fetch_standards.py`. The folder itself stays tracked via
# .gitkeep, and README.md documents the naming/routing contract.
docs/scraped_standards/*
!docs/scraped_standards/.gitkeep
!docs/scraped_standards/README.md

# Generated BCF archives. Only the README is tracked.
docs/bcf_exports/*
!docs/bcf_exports/README.md

# Downloaded IFC test models (scripts/fetch_test_model.py). Large binaries;
# fetched on demand from maicen/bimguard-test-models. Only the README is tracked.
data/test_models/*
!data/test_models/README.md

# Per-building federation staging for scripts/run_full_pipeline.py --auto-extra
# (copies of data/test_models, so --auto-extra federates one building rather
# than every model in the flat directory). See docs/validation/seismic-and-coverage-2026-09.md.
data/federated/

# Demo corrosion model: regenerated byte-identically by
# scripts/generate_demo_mep_model.py, so the generator is the tracked artefact
# and the 660 KB of IFC it produces is not.
data/*_demo.ifc

# Claude Code per-machine settings: a local permission allowlist that differs
# on every developer's machine. The shared settings live in .claude/settings.json.
.claude/settings.local.json
