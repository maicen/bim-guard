      "property_name": "HostElement",
      "operator": "exists",
      "severity": "mandatory",
      "check_category": "Opening, Host, Space and Relationship Context",
      "mechanism": "DATA_QC",
      "needs_review": false,
      "extraction_method": "seed"
    },
