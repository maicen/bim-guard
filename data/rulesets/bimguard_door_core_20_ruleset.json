{
  "ruleset_id": "BIMGUARD-DOOR-CORE-20",
  "mechanism": "CODE",
  "category": "Arch",
  "rules": [
    {
      "reference": "DR-001",
      "rule_type": "numeric_comparison",
      "rule_category": "property_check",
      "description": "Every door must be at least 800 mm wide (overall width).",
      "target_ifc_class": "IfcDoor",
      "property_name": "OverallWidth",
      "operator": ">=",
      "check_value": 800,
      "unit": "mm",
      "severity": "mandatory",
      "check_category": "Core Door Dimensions and Geometry",
      "mechanism": "CODE",
      "needs_review": false,
      "extraction_method": "seed"
    },
    {
      "reference": "DR-002",
      "rule_type": "numeric_comparison",
      "rule_category": "property_check",
      "description": "Every door must be at least 1980 mm high (overall height).",
      "target_ifc_class": "IfcDoor",
      "property_name": "OverallHeight",
      "operator": ">=",
      "check_value": 1980,
      "unit": "mm",
      "severity": "mandatory",
      "check_category": "Core Door Dimensions and Geometry",
      "mechanism": "CODE",
      "needs_review": false,
      "extraction_method": "seed"
    },
    {
      "reference": "DR-003",
      "rule_type": "property_presence",
      "rule_category": "property_check",
      "description": "Every door should carry its area as a base quantity.",
      "target_ifc_class": "IfcDoor",
      "property_name": "Area",
      "operator": "documented",
      "severity": "recommended",
      "check_category": "Core Door Dimensions and Geometry",
      "mechanism": "DATA_QC",
      "needs_review": false,
      "extraction_method": "seed"
    },
    {
      "reference": "DR-004",
      "rule_type": "property_presence",
      "rule_category": "property_check",
      "description": "Every door should state its predefined type (DOOR, GATE, TRAPDOOR). Needs an IFC4 export.",
      "target_ifc_class": "IfcDoor",
      "property_name": "PredefinedType",
      "operator": "documented",
      "severity": "recommended",
      "check_category": "Door Element and Type Identity",
      "mechanism": "DATA_QC",
      "needs_review": false,
      "extraction_method": "seed"
    },
    {
      "reference": "DR-005",
      "rule_type": "property_presence",
      "rule_category": "property_check",
      "description": "Every door must state how it operates (swing, sliding, folding); NOTDEFINED is not accepted.",
      "target_ifc_class": "IfcDoor",
      "property_name": "OperationType",
      "operator": "!=",
      "check_value": "NOTDEFINED",
      "severity": "mandatory",
      "check_category": "Door Operation, Swing and Panel Configuration",
      "mechanism": "DATA_QC",
      "needs_review": false,
      "extraction_method": "seed"
    },
    {
      "reference": "DR-006",
      "rule_type": "property_presence",
      "rule_category": "property_check",
      "description": "Every door must have an IFC GlobalId.",
      "target_ifc_class": "IfcDoor",
      "property_name": "GlobalId",
      "operator": "exists",
      "severity": "mandatory",
      "check_category": "Door Element and Type Identity",
      "mechanism": "DATA_QC",
      "needs_review": false,
      "extraction_method": "seed"
    },
    {
      "reference": "DR-007",
      "rule_type": "property_presence",
      "rule_category": "property_check",
      "description": "Every door must have a tag (door mark).",
      "target_ifc_class": "IfcDoor",
      "property_name": "Tag",
      "operator": "exists",
      "severity": "mandatory",
      "check_category": "Door Element and Type Identity",
      "mechanism": "DATA_QC",
      "needs_review": false,
      "extraction_method": "seed"
    },
