{
  "ruleset_id": "BIMGUARD-WINDOW-CORE-20",
  "mechanism": "CODE",
  "category": "Arch",
  "rules": [
    {
      "reference": "WN-001",
      "rule_type": "numeric_comparison",
      "rule_category": "property_check",
      "description": "Illustrative threshold - verify against your applicable code before enforcing: every window is at least 380 mm wide (overall width).",
      "target_ifc_class": "IfcWindow",
      "property_name": "OverallWidth",
      "operator": ">=",
      "check_value": 380,
      "unit": "mm",
      "severity": "mandatory",
      "check_category": "Core Dimensions and Relationships",
      "mechanism": "CODE",
      "needs_review": true,
      "extraction_method": "seed"
    },
    {
      "reference": "WN-002",
      "rule_type": "numeric_comparison",
      "rule_category": "property_check",
      "description": "Illustrative threshold - verify against your applicable code before enforcing: every window is at least 380 mm high (overall height).",
      "target_ifc_class": "IfcWindow",
      "property_name": "OverallHeight",
      "operator": ">=",
      "check_value": 380,
      "unit": "mm",
      "severity": "mandatory",
      "check_category": "Core Dimensions and Relationships",
      "mechanism": "CODE",
      "needs_review": true,
      "extraction_method": "seed"
    },
    {
      "reference": "WN-003",
      "rule_type": "numeric_comparison",
      "rule_category": "property_check",
      "description": "Illustrative threshold - verify against your applicable code before enforcing: every window sill is no more than 1000 mm above its storey floor.",
      "target_ifc_class": "IfcWindow",
      "property_name": "SillHeight",
      "operator": "<=",
      "check_value": 1000,
      "unit": "mm",
      "severity": "mandatory",
      "check_category": "Emergency Escape",
      "mechanism": "CODE",
      "needs_review": true,
      "extraction_method": "seed"
    },
    {
      "reference": "WN-004",
      "rule_type": "numeric_comparison",
      "rule_category": "property_check",
