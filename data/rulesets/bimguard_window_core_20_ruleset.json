      "property_name": "HeadHeight",
      "operator": ">=",
      "check_value": 2000,
      "unit": "mm",
      "severity": "recommended",
      "check_category": "Core Dimensions and Relationships",
      "mechanism": "CODE",
      "needs_review": true,
      "extraction_method": "seed"
    },
