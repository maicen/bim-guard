# ==============================================================================
# Local Supabase CLI stack overrides — reference values, not a standalone .env.
#
# These are the exact SUPABASE_* values `supabase start` prints for THIS
# project every time (deterministic per supabase/config.toml, not fetched
# from a server), so they're safe to commit — they only ever unlock the
# throwaway local database on your own machine, never the hosted project.
#
# Usage: `supabase start`, then copy the block below into your real `.env`,
# replacing the hosted SUPABASE_* values there (see the "Local Development
# Database & Storage" section in example.env for the full walkthrough, and
# frontend/.env.example for the matching VITE_SUPABASE_* pair). Copying
# instead of loading this file automatically keeps a single source of
# truth (.env) for run_server.sh / app/environment.py's load_env_file().
# `supabase stop && supabase start` reprints the same values if you ever
# need to re-check them.
# ==============================================================================

SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU
SUPABASE_JWKS_URL=http://127.0.0.1:54321/auth/v1/.well-known/jwks.json
SUPABASE_STORAGE_BUCKET=bim-guard-artifacts

# Frontend needs the matching pair in frontend/.env (see frontend/.env.example):
#   VITE_SUPABASE_URL=http://127.0.0.1:54321
#   VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# Only needed if you also run `docker compose up` locally (opencde/neo4j/docling)
# — see docker-compose.override.yml for why opencde needs the host-loopback alias
# instead of 127.0.0.1.
OPENCDE_SUPABASE_URL=http://host.docker.internal:54321
