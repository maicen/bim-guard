# ── Self-Hosted Supabase Environment Example ─────────────────────────
POSTGRES_PASSWORD=your-super-secret-postgres-password
POSTGRES_DB=postgres
POSTGRES_PORT=5432

JWT_SECRET=your-32-byte-hex-jwt-secret
JWT_EXPIRY=3600

# Generated HS256 tokens using the JWT_SECRET above
ANON_KEY=your-generated-anon-jwt-token
SERVICE_ROLE_KEY=your-generated-service-role-jwt-token
SUPABASE_ANON_KEY=your-generated-anon-jwt-token
SUPABASE_SERVICE_KEY=your-generated-service-role-jwt-token

DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=your-studio-admin-password

SECRET_KEY_BASE=your-secret-key-base-min-64-chars
VAULT_ENC_KEY=your-vault-encryption-key-32-chars
PG_META_CRYPTO_KEY=your-pg-meta-crypto-key-32-chars

SITE_URL=https://bim-guard.xyz
API_EXTERNAL_URL=https://supabase.bim-guard.xyz
SUPABASE_PUBLIC_URL=https://supabase.bim-guard.xyz
ADDITIONAL_REDIRECT_URLS=https://bim-guard.xyz/**,http://localhost:5173/**,http://localhost:8000/**

GOTRUE_EXTERNAL_GOOGLE_ENABLED=true
GOOGLE_OATH_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

KONG_HTTP_PORT=54321
STUDIO_PORT=54323
POSTGRES_EXPOSED_PORT=54322
