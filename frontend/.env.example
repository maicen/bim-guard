# Copy to frontend/.env and fill in — values come from the Supabase dashboard
# (Project Settings > API). Both are safe to expose to the browser: the anon
# key is meant to be public and is scoped by RLS, not secrecy.

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...

# Optional: enables a "Sign in as dev test user" button on the login screen
# (dev builds only) that signs in with a password instead of Google OAuth.
# Seed the account first with `uv run python scripts/seed_dev_auth_user.py`.
VITE_DEV_AUTH_EMAIL=dev@bim-guard.local
VITE_DEV_AUTH_PASSWORD=bim-guard-dev-only
