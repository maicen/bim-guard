{
  "name": "bim-guard-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run check && vite build",
    "build:fast": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate:api-types": "openapi-typescript http://127.0.0.1:8000/api/openapi.json -o src/lib/generated/openapi-types.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.115.0",
    "clsx": "^2.1.1",
    "lucide-svelte": "^0.475.0",
    "pdfjs-dist": "^4.0.379",
    "svelte-spa-router": "^5.1.1",
    "tailwind-merge": "^3.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "autoprefixer": "^10.4.20",
    "eslint": "^10.9.1",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.12.0",
    "openapi-typescript": "^7.13.0",
    "postcss": "^8.5.1",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "svelte": "^5.19.7",
    "svelte-check": "^4.7.6",
    "svelte-eslint-parser": "^1.8.1",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^6.1.0"
  }
}
